{
  "name": "nextjs-claude-starter",
  "version": "1.0.0",
  "private": true,
  "description": "AI-native engineering starter for Next.js projects using Claude Code.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "architecture:check": "depcruise src --config ai-workflow-config/dependency-cruiser.cjs",
    "architecture:graph": "depcruise src --config ai-workflow-config/dependency-cruiser.cjs --output-type dot",
    "check": "pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm test"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9"
}
